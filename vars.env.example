# ============================================================
# Mihomo 配置变量 — 复制为 vars.env 并填入真实值
#
#   cp vars.env.example vars.env && chmod 600 vars.env
#
# vars.env 已在 .gitignore 中，**绝不要**把填好的它提交上去。
# 下面 7 个键是 update_subscription.sh 强制要求非空的，缺一个就会拒绝运行。
# ============================================================

# 机场订阅链接
SUBSCRIBE_URL=https://your-airport.example.com/api/v1/client/subscribe?token=YOUR_TOKEN&flag=clash

# 出口 SOCKS5 节点
EXIT_SERVER=your.exit.server.ip
EXIT_PORT=1080
EXIT_USER=your_username
EXIT_PASS=your_password

# Mihomo API 密钥（自定义即可；它同时是 Web 面板的登录密码）
API_SECRET=change-me-to-a-random-string

# 解析代理服务器域名用的 DoH（机场节点域名常被 GTM 轮询，换一个有时能解决
# "整批节点解析到被墙 IP"；dns-select.sh 手动诊断时也会读写这个值）
PROXY_DNS=https://doh.pub/dns-query

# 机场主策略组名 → 本项目策略组名（sync_airport_rules.sh 用）
#
# 机场订阅本身是完整 Clash 配置，但它规则里的目标指向**它自己的**策略组。
# 本项目以 proxy-provider 方式引用订阅（只取节点列表），把规则捞回来用时，
# 必须把这些组名重写成本项目存在的组，否则 mihomo 会因目标不存在而拒绝整份配置。
#
# 格式: 机场组=本项目组，逗号分隔多项。
# 机场的主 select 组通常承载它绝大多数规则（可用 sync_airport_rules.sh --check 观察分布）。
# 映射到 Proxy  = 走本项目的代理链（第一跳节点池 → 固定出口），保住固定出网身份
# 映射到 第一跳节点池 = 直接用机场节点，延迟更低但出网 IP 会随节点变化
AIRPORT_GROUP_MAP=机场主组名=Proxy
